# --- Server ---
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL on Hostinger) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ramex_store
DB_USER=ramex_user
DB_PASSWORD=
DB_SSL=false

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Logging ---
LOG_LEVEL=info
